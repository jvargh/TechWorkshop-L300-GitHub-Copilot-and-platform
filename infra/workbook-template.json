{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## AI Services Observability Dashboard\n\nThis workbook provides insights into AI Services usage, performance, and operations."
      },
      "name": "text - title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "time-range-parameter",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 3600000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 300000
                },
                {
                  "durationMs": 900000
                },
                {
                  "durationMs": 1800000
                },
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 172800000
                },
                {
                  "durationMs": 259200000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2419200000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            },
            "label": "Time Range"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters - time range"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Request Volume"
      },
      "name": "text - request volume header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppRequests\n| where TimeGenerated {TimeRange}\n| summarize RequestCount = count() by bin(TimeGenerated, 5m)\n| order by TimeGenerated asc\n| project TimeGenerated, RequestCount",
        "size": 0,
        "title": "Request Volume Over Time",
        "timeContext": {
          "durationMs": 3600000
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart",
        "chartSettings": {
          "seriesLabelSettings": [
            {
              "seriesName": "RequestCount",
              "label": "Requests"
            }
          ],
          "ySettings": {
            "numberFormatSettings": {
              "unit": 0,
              "options": {
                "style": "decimal"
              }
            }
          }
        }
      },
      "name": "query - request volume"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Latency Percentiles"
      },
      "name": "text - latency header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppRequests\n| where TimeGenerated {TimeRange}\n| summarize \n    P50 = percentile(DurationMs, 50),\n    P90 = percentile(DurationMs, 90),\n    P95 = percentile(DurationMs, 95),\n    P99 = percentile(DurationMs, 99)\n    by bin(TimeGenerated, 5m)\n| order by TimeGenerated asc\n| project TimeGenerated, P50, P90, P95, P99",
        "size": 0,
        "title": "Request Latency Percentiles (ms)",
        "timeContext": {
          "durationMs": 3600000
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart",
        "chartSettings": {
          "seriesLabelSettings": [
            {
              "seriesName": "P50",
              "label": "50th Percentile"
            },
            {
              "seriesName": "P90",
              "label": "90th Percentile"
            },
            {
              "seriesName": "P95",
              "label": "95th Percentile"
            },
            {
              "seriesName": "P99",
              "label": "99th Percentile"
            }
          ],
          "ySettings": {
            "numberFormatSettings": {
              "unit": 23,
              "options": {
                "style": "decimal",
                "useGrouping": true
              }
            }
          }
        }
      },
      "name": "query - latency percentiles"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Operations Breakdown"
      },
      "name": "text - operations header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppRequests\n| where TimeGenerated {TimeRange}\n| summarize \n    RequestCount = count(),\n    AvgDuration = avg(DurationMs),\n    SuccessRate = round(100.0 * countif(Success == true) / count(), 2)\n    by OperationName\n| order by RequestCount desc\n| project OperationName, RequestCount, AvgDuration, SuccessRate",
        "size": 0,
        "title": "Breakdown by Operation Name",
        "timeContext": {
          "durationMs": 3600000
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "RequestCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "blue"
              }
            },
            {
              "columnMatch": "AvgDuration",
              "formatter": 0,
              "formatOptions": {
                "customColumnWidthSetting": "20ch"
              },
              "numberFormat": {
                "unit": 23,
                "options": {
                  "style": "decimal",
                  "useGrouping": false,
                  "maximumFractionDigits": 2
                }
              }
            },
            {
              "columnMatch": "SuccessRate",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": ">=",
                    "thresholdValue": "95",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "error",
                    "text": "{0}{1}"
                  }
                ]
              },
              "numberFormat": {
                "unit": 1,
                "options": {
                  "style": "decimal",
                  "useGrouping": false,
                  "maximumFractionDigits": 2
                }
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "OperationName",
              "label": "Operation"
            },
            {
              "columnId": "RequestCount",
              "label": "Total Requests"
            },
            {
              "columnId": "AvgDuration",
              "label": "Avg Duration (ms)"
            },
            {
              "columnId": "SuccessRate",
              "label": "Success Rate (%)"
            }
          ]
        }
      },
      "name": "query - operations breakdown"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Content Safety Logs"
      },
      "name": "text - content safety header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppTraces\n| where TimeGenerated {TimeRange}\n| where Message startswith \"ContentSafety\"\n| project TimeGenerated, SeverityLevel, Message, OperationId\n| order by TimeGenerated desc",
        "size": 0,
        "title": "Content Safety Analysis Logs",
        "timeContext": {
          "durationMs": 3600000
        },
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "TimeGenerated",
              "formatter": 6,
              "dateFormat": {
                "formatName": "shortDateTimePattern"
              }
            },
            {
              "columnMatch": "SeverityLevel",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "3",
                    "representation": "warning",
                    "text": "Warning"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "2",
                    "representation": "info",
                    "text": "Info"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "1",
                    "representation": "success",
                    "text": "Verbose"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "info",
                    "text": "{0}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "TimeGenerated",
              "label": "Timestamp"
            },
            {
              "columnId": "SeverityLevel",
              "label": "Severity"
            },
            {
              "columnId": "Message",
              "label": "Log Message"
            },
            {
              "columnId": "OperationId",
              "label": "Operation ID"
            }
          ]
        }
      },
      "name": "query - content safety logs"
    }
  ],
  "fallbackResourceIds": [],
  "fromTemplateId": "sentinel-UserWorkbook",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
